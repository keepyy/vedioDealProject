# ===== 基础配置 =====
APP_HOST=0.0.0.0
APP_PORT=8000

# 存储目录（视频、临时文件、成品）
STORAGE_DIR=./storage

# ===== Docker 沙箱配置 =====
# ffmpeg 工作容器镜像（含 ffmpeg + python + opencv）
SANDBOX_IMAGE=vedio-agent-worker:latest
# 单任务 CPU 配额（单位：CPU 核数）
SANDBOX_CPU_LIMIT=2.0
# 单任务内存上限
SANDBOX_MEM_LIMIT=4g
# 单任务超时（秒）
SANDBOX_TIMEOUT=1800
# 是否启用沙箱（False 时直接在本机 subprocess 执行，便于调试）
SANDBOX_ENABLED=true

# ===== 视频处理默认值 =====
# 默认分割时长（秒），15 分钟 = 900
DEFAULT_SEGMENT_SECONDS=900
# 单视频最大时长（秒），2.5 小时 = 9000
MAX_VIDEO_SECONDS=9000
# 单视频最大上传体积（MB）
MAX_UPLOAD_MB=8192

# ===== 检测参数 =====
# 横幅检测：检查画面上下多少比例区域
BANNER_SCAN_RATIO=0.15
# 台标/标识检测：跨多少帧做静态区域分析
LOGO_SAMPLE_FRAMES=30
# 静态区域方差阈值，低于此值视为静态水印
LOGO_STATIC_THRESHOLD=8.0

# ===== 飞书配置 =====
# 在 https://open.feishu.cn 创建“企业自建应用”后获取
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 接收消息的用户 open_id（个人发布时填自己的 open_id）
FEISHU_RECEIVE_OPEN_ID=
# 是否启用飞书推送
FEISHU_ENABLED=false
