# ===== 基础配置 =====
APP_HOST=0.0.0.0
APP_PORT=8000
# Docker 对局域网公开的访问端口
LAN_PORT=8080
# 飞书消息中用于打开剪辑页面的 HTTPS 公网地址，不要以 / 结尾
PUBLIC_BASE_URL=

# ===== 百度网盘开放平台 =====
# 同时配置 API Key 与 Secret Key 时使用官方 OAuth/API + dlink + aria2；留空则回退 bdpan
BAIDU_APP_KEY=
BAIDU_APP_SECRET=
# 开放平台应用目录名，对应 /apps/<应用目录名>
BAIDU_APP_NAME=bdpan
# 必须与百度开放平台应用配置一致；无 Web 回调可使用 oob
BAIDU_OAUTH_REDIRECT_URI=oob
BAIDU_ARIA2_CONNECTIONS=8
BAIDU_ARIA2_SPLIT=8
BAIDU_ARIA2_MIN_SPLIT_SIZE=1M

# ===== 飞书 Bot =====
FEISHU_ENABLED=false
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
# 当前 Webhook 版本暂不支持加密事件；飞书后台请先关闭加密策略
FEISHU_ENCRYPT_KEY=
FEISHU_REQUEST_TIMEOUT_SEC=30
FEISHU_DOWNLOAD_TIMEOUT_SEC=1800

# 存储目录（视频、临时文件、成品）
STORAGE_DIR=./storage

# ===== Docker 沙箱配置 =====
# ffmpeg 工作容器镜像（含 ffmpeg + python + opencv）
SANDBOX_IMAGE=vedio-agent-worker:latest
# 单任务 CPU 配额（单位：CPU 核数）
SANDBOX_CPU_LIMIT=2.0
# 单任务内存上限
SANDBOX_MEM_LIMIT=4g
# 单任务超时（秒）
SANDBOX_TIMEOUT=1800
# 是否启用沙箱（False 时直接在本机 subprocess 执行，便于调试）
SANDBOX_ENABLED=true

# ===== 视频处理默认值 =====
# 默认分割时长（秒），15 分钟 = 900
DEFAULT_SEGMENT_SECONDS=900
# 单视频最大时长（秒），2.5 小时 = 9000
MAX_VIDEO_SECONDS=9000
# 单视频最大上传体积（MB）
MAX_UPLOAD_MB=8192

# ===== 检测参数 =====
# 横幅检测：检查画面上下多少比例区域
BANNER_SCAN_RATIO=0.15
# 台标/标识检测：跨多少帧做静态区域分析
LOGO_SAMPLE_FRAMES=30
# 静态区域方差阈值，低于此值视为静态水印
LOGO_STATIC_THRESHOLD=8.0
